{
  "name": "taste-probe",
  "version": "0.1.0",
  "private": true,
  "description": "TasteProbe: adaptive, Qloo-grounded cultural discovery (S1 walking skeleton, mock mode).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "cross-env QLOO_MODE=mock next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:session": "vitest run tests/unit/session-security.test.ts tests/unit/session-store.test.ts tests/unit/session-config.test.ts",
    "test:redis": "cross-env RUN_REDIS_LIVE_TEST=1 vitest run tests/live/redis-store.live.test.ts",
    "smoke": "node scripts/smoke-mock.mjs",
    "smoke:mock": "node scripts/smoke-mock.mjs",
    "smoke:multi-round": "node scripts/smoke-multi-round.mjs",
    "smoke:listening": "vitest run tests/integration/listening-journey.test.ts --reporter=verbose",
    "qa:ui": "node scripts/ui-qa.mjs",
    "qa:passport": "node scripts/ui-qa-passport.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:live": "node scripts/qa-live.mjs",
    "qa:adaptive-live": "node scripts/qa-adaptive-live.mjs",
    "qa:music": "node scripts/ui-qa-passport.mjs",
    "qa:listening": "node scripts/qa-release-recovery.mjs",
    "audit:release-secrets": "node scripts/audit-release-secrets.mjs",
    "verify:mappings": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-music-mappings.mjs",
    "evaluate": "vitest run tests/evaluation/question-evaluation.test.ts tests/evaluation/question-quality.test.ts tests/evaluation/question-wording.test.ts --reporter=verbose",
    "smoke:qloo": "node scripts/smoke-qloo.mjs",
    "smoke:gemini": "node scripts/smoke-gemini.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "smoke:questions-live": "node scripts/smoke-questions-live.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "evaluate:questions": "vitest run tests/evaluation/question-evaluation.test.ts --reporter=verbose",
    "evaluate:question-quality": "vitest run tests/evaluation/question-quality.test.ts --reporter=verbose",
    "optimize:question-quality": "vitest run tests/evaluation/question-optimization.test.ts --reporter=verbose",
    "evaluate:question-wording": "vitest run tests/evaluation/question-wording.test.ts --reporter=verbose",
    "evaluate:adaptive": "vitest run tests/evaluation/adaptive-retrieval.test.ts --reporter=verbose",
    "evaluate:songs": "vitest run tests/evaluation/song-selection.test.ts --reporter=verbose",
    "probe:live": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probe-live.mjs",
    "probe:pivot": "vitest run --config scripts/vitest.pivot.config.mts scripts/probe-pivot.test.ts",
    "probe:cross-domain": "vitest run --config scripts/vitest.pivot.config.mts scripts/probe-cross-domain.test.ts",
    "probe:adaptive": "vitest run --config scripts/vitest.pivot.config.mts scripts/probe-adaptive-retrieval.test.ts",
    "probe:youtube": "vitest run --config scripts/vitest.pivot.config.mts scripts/probe-youtube-dynamic.test.ts"
  },
  "dependencies": {
    "@upstash/redis": "1.39.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fengari": "0.1.5",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
