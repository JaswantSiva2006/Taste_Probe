# TasteProbe environment contract. Copy to .env.local for local development.
# Every variable is server-side only (there are no NEXT_PUBLIC_ variables). Never commit real values.
# Full reference: docs/DEPLOYMENT.md

# ---------------------------------------------------------------- mode
# "mock" = synthetic fixtures, no external calls (start here). "live" = real Qloo + Gemini.
QLOO_MODE=mock

# ---------------------------------------------------------------- Qloo (live mode)
QLOO_API_KEY=your-qloo-api-key
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_MS=8000

# ---------------------------------------------------------------- Gemini (live mode)
# LLM_PROVIDER: google (canonical) | gemini (alias) | none. Live production requires google/gemini.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=your-google-api-key
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=15000
# deterministic | llm_grounded (Gemini proposes grounded preference questions)
QUESTION_GENERATION_MODE=deterministic

# ---------------------------------------------------------------- sessions
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional only for local mock development (an ephemeral secret is generated per process).
SESSION_SIGNING_SECRET=
SESSION_TTL_SECONDS=1800
# memory | redis. Production always uses Redis and refuses memory.
# SESSION_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- YouTube (optional)
# Dedicated YouTube Data API v3 keys; never reuse GOOGLE_API_KEY. Without a key, only the reviewed
# recording registry is used. Optional failover keys are tried in order on quota/key errors.
# Quota is per Google Cloud PROJECT: each key must come from a different project/account.
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_TIMEOUT_MS=5000
# Deployment-wide daily cap across all keys (about 100 searches per project per day; max 300).
YOUTUBE_DAILY_SEARCH_MAX=80
YOUTUBE_SEARCHES_PER_EXPLORATION=12

# ---------------------------------------------------------------- budgets
MAX_QUESTIONS=3
MAX_QLOO_CALLS_PER_SESSION=6
# Taste-graph walk allowance (Qloo neighbourhood/blend queries + scout searches). 0 disables the walk.
MAX_QLOO_WALK_CALLS=15
MAX_AGENT_TOOL_CALLS_PER_TURN=3
MAX_GEMINI_REQUESTS_PER_EXPLORATION=30
MAX_RECOMMENDATION_CANDIDATES=50
FINAL_RECOMMENDATION_COUNT=5

# ---------------------------------------------------------------- features
ENABLE_ADAPTIVE_QUESTIONING=true
ENABLE_EARLY_STOPPING=true
# Adaptive listening: reactions, listening time and saves re-rank recordings.
ADAPTIVE_LISTENING_ENABLED=true
# Adaptive reservoir + taste-graph walk (re-seeds Qloo from artists the listener responds to).
ADAPTIVE_POOL_ENABLED=true
# Kill switch for starting/continuing explorations (provider spend).
ENABLE_EXPENSIVE_OPERATIONS=true

# ---------------------------------------------------------------- rate limits (per client IP)
# On by default in production. Window applies to every bucket.
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_START_MAX=10
RATE_LIMIT_ANSWER_MAX=30
# Starting/switching listening and /api/music/resolve.
RATE_LIMIT_RESOLVE_MAX=60
# Listening actions (Love, Not for me, Next, Save, ...).
RATE_LIMIT_FEEDBACK_MAX=240
# Only when NOT hosted on Vercel: the trusted proxy header carrying the client IP.
# TRUSTED_PROXY_IP_HEADER=

# ---------------------------------------------------------------- diagnostics
ENABLE_EVALUATION_LOGGING=false
ENABLE_AGENT_TRACING=false
# Non-production only (refused in production):
MUSIC_MOMENT_REVIEW=false
# LEGACY_GENERIC_JOURNEYS=false   # non-music (book) journeys for internal regression tests
# VERIFICATION_PAIRS=             # internal pair verification
