# Copy to .env.local and fill in locally. Never commit real values.

# Provider mode: "mock" (synthetic fixtures, no external calls) or "live".
# Live Qloo is not implemented yet (S1): live mode returns an explicit 501 error.
QLOO_MODE=mock

# Qloo (unused in mock mode)
QLOO_API_KEY=your-qloo-api-key
QLOO_BASE_URL=https://example.invalid/qloo-base-url
QLOO_TIMEOUT_MS=8000

# LLM agent (Gemini; unused in S1, which uses a deterministic mock agent)
LLM_PROVIDER=gemini
LLM_MODEL=your-gemini-model-id
GOOGLE_API_KEY=your-google-api-key
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=15000

# Session signing: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in live mode and production. Optional for local mock dev
# (an ephemeral random secret is generated per process).
SESSION_SIGNING_SECRET=
SESSION_TTL_SECONDS=1800

# Budgets
MAX_QUESTIONS=3
MAX_QLOO_CALLS_PER_SESSION=6
MAX_AGENT_TOOL_CALLS_PER_TURN=3
MAX_RECOMMENDATION_CANDIDATES=8
FINAL_RECOMMENDATION_COUNT=5

# Feature flags (parsed now, wired in later segments)
ENABLE_ADAPTIVE_QUESTIONING=true
ENABLE_EARLY_STOPPING=true
ENABLE_QLOO_CACHE=false
CACHE_TTL_SECONDS=3600
ENABLE_EVALUATION_LOGGING=false
ENABLE_AGENT_TRACING=false

# Observability (optional)
SENTRY_DSN=
