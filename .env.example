# Copy to .env.local and fill in locally. Never commit real values.

# Provider mode: "mock" (synthetic fixtures, no external calls) or "live".
# Live mode uses authenticated Qloo Search/Insights and the bounded Gemini agent.
QLOO_MODE=mock

# Qloo (unused in mock mode; base URL must be a valid HTTPS URL)
QLOO_API_KEY=your-qloo-api-key
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_MS=8000

# LLM agent (Gemini, S6). Used only in live mode and by `npm run smoke:gemini`; mock mode never calls it.
# Canonical: google. Legacy alias: gemini. `none` explicitly disables inference in live mode.
# In live mode a missing/invalid Gemini configuration is an error (never a silent mock fallback).
LLM_PROVIDER=google
LLM_MODEL=your-gemini-model-id
GOOGLE_API_KEY=your-google-api-key
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=15000
QUESTION_GENERATION_MODE=deterministic

# Session signing: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in live mode and production. Optional for local mock dev
# (an ephemeral random secret is generated per process).
SESSION_SIGNING_SECRET=
SESSION_TTL_SECONDS=1800

# Session store (authoritative, replay-safe session state).
# Outside production the default is an in-process memory store (single instance only).
# In production (NODE_ENV=production) Upstash Redis is REQUIRED: the app fails closed
# without these, and SESSION_STORE=memory is rejected. Get both from the Upstash console.
# SESSION_STORE=memory            # optional: memory | redis (redis needs the two values below)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Budgets
MAX_QUESTIONS=3
MAX_QLOO_CALLS_PER_SESSION=6
MAX_QLOO_WALK_CALLS=15
MAX_AGENT_TOOL_CALLS_PER_TURN=3
MAX_RECOMMENDATION_CANDIDATES=50
FINAL_RECOMMENDATION_COUNT=5

# Feature flags
ENABLE_ADAPTIVE_QUESTIONING=true
ENABLE_EARLY_STOPPING=true
ENABLE_QLOO_CACHE=false
CACHE_TTL_SECONDS=3600
ENABLE_EVALUATION_LOGGING=false
ENABLE_AGENT_TRACING=false

# Observability (optional)
SENTRY_DSN=

# S9.9 music playback (optional). A dedicated YouTube Data API v3 key; never reuse GOOGLE_API_KEY.
# Leave empty to keep dynamic lookup disabled (reviewed mappings + honest fallbacks only, zero cost).
YOUTUBE_API_KEY=
ADAPTIVE_POOL_ENABLED=false
ADAPTIVE_LISTENING_ENABLED=true
YOUTUBE_TIMEOUT_MS=5000
YOUTUBE_DAILY_SEARCH_MAX=80
YOUTUBE_SEARCHES_PER_EXPLORATION=6
RATE_LIMIT_RESOLVE_MAX=60
# Non-production only: show PENDING_REVIEW featured moments (labelled unreviewed) for human review.
MUSIC_MOMENT_REVIEW=false
